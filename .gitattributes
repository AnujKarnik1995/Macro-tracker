# Normalize line endings: store everything as LF in the repo, check out
# native on each OS. Stops CRLF/LF churn from polluting diffs.
* text=auto

# Source / text — force LF in the repo regardless of platform.
*.kt      text eol=lf
*.kts     text eol=lf
*.java    text eol=lf
*.xml     text eol=lf
*.gradle  text eol=lf
*.pro     text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.properties text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf

# Platform-specific scripts keep their required endings.
gradlew   text eol=lf
*.sh      text eol=lf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary — never touch.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.jar     binary
*.keystore binary
*.jks     binary
*.apk     binary
*.aab     binary
*.ttf     binary
*.otf     binary
