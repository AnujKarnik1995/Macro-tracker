# .gitignore

# -----------------------
# Database & Live Data
# -----------------------
# NEVER commit the live database binary. 
data/*.db
data/*.sqlite
data/*.sqlite3

# -----------------------
# C++ / Build Files
# -----------------------
backend-cpp/build/
backend-cpp/bin/
*.o
*.out
*.cmake
CMakeCache.txt
CMakeFiles/

# -----------------------
# Python
# -----------------------
__pycache__/
*.py[cod]
*$py.class
backup-python/venv/
backup-python/.env

# -----------------------
# OS & Environment
# -----------------------
.DS_Store
.env

