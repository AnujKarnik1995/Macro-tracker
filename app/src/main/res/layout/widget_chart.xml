<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="4dp">

    <!-- Rendered frame. No longer clickable itself; the tap halves below cover it. -->
    <ImageView
        android:id="@+id/chart_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:contentDescription="@string/chart_desc" />

    <!-- Full-tile tap halves: left = previous page, right = next page.
         Declared AFTER chart_image so they receive taps; declared BEFORE refresh_hit
         so the refresh corner (topmost) overrides the right half and never pages. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/page_prev_hit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/page_prev_desc" />

        <FrameLayout
            android:id="@+id/page_next_hit"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/page_next_desc" />
    </LinearLayout>

    <!-- Bottom-right corner overlay: tap refreshes (aligns with the drawn ↻ button).
         Last child = topmost, so it wins taps in the corner over page_next_hit. -->
    <FrameLayout
        android:id="@+id/refresh_hit"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="bottom|end"
        android:background="@android:color/transparent"
        android:contentDescription="@string/refresh_desc" />
</FrameLayout>
